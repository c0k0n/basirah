---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="စာမျက်နှာ မတွေ့ပါ — Basirah"
	description="သင်ရှာဖွေနေသော စာမျက်နှာကို ရှာမတွေ့ပါ။"
	noindex
>
	<section class="not-found">
		<h1>404</h1>
		<p lang="my" class="hero-tagline">
			တောင်းပန်ပါသည် — သင်ရှာနေသော စာမျက်နှာကို ရှာမတွေ့ပါ။
		</p>
		<p class="hero-sub" lang="en">
			The page you are looking for could not be found.
		</p>
		<a class="btn" href="/">
			<span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
			<span lang="my">မူလစာမျက်နှာသို့ ပြန်သွားရန်</span>
		</a>
	</section>
</Layout>
