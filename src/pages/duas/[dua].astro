---
import Layout from "../../layouts/Layout.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
	dua: CollectionEntry<"duas">;
}

export async function getStaticPaths() {
	const duas = await getCollection("duas");
	return duas.map((dua) => ({ params: { dua: dua.id }, props: { dua } }));
}

const { dua } = Astro.props;
---

<Layout
	title={`${dua.data.title_mm} — Basirah`}
	description={`${dua.data.title_mm} — အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် မြန်မာ/အင်္ဂလိပ် အဓိပ္ပာယ်တို့ ပါဝင်ပါသည်။`}
	ogType="article"
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": "WebPage",
			name: dua.data.title_mm,
			url: new URL(`/duas/${dua.id}/`, Astro.site).href,
			description: `${dua.data.title_mm} — အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် မြန်မာ/အင်္ဂလိပ် အဓိပ္ပာယ်တို့ ပါဝင်ပါသည်။`,
			inLanguage: ["my", "en", "ar"],
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "မူလစာမျက်နှာ",
						item: new URL("/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်",
						item: new URL("/duas/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 3,
						name: dua.data.title_mm,
						item: new URL(`/duas/${dua.id}/`, Astro.site).href,
					},
				],
			},
		}}
	/>
	<a class="back-link" href="/duas/">
		<span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
		<span lang="my">ဒိုအာများအားလုံး</span>
		<span lang="en">· All duas</span>
	</a>

	<h1 class="visually-hidden" lang="my">{dua.data.title_mm}</h1>

	<div class="dua-detail-arabic">
		<p lang="ar" dir="rtl">{dua.data.arabic}</p>
		<p class="dua-pronunciation" lang="my">{dua.data.burmese_pronunciation}</p>
	</div>

	<section class="dua-meaning">
		<h2>
			<span lang="my">အဓိပ္ပာယ်</span>
		</h2>
		<p lang="my">{dua.data.burmese_meaning}</p>
	</section>

	<section class="dua-meaning">
		<h2>
			<span lang="en">Translation</span>
		</h2>
		<p class="dua-translation" lang="en">{dua.data.english_meaning}</p>
	</section>
</Layout>
