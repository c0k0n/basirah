---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ListFilter from "../../components/ListFilter.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";

const duas = (await getCollection("duas")).sort(
	(a, b) => Number(a.id) - Number(b.id),
);
---

<Layout
	title="မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်များ — Basirah"
	description={`နေ့စဉ်ဘဝအတွက် မရှိမဖြစ် ဒိုအာ ${duas.length} ခုကို အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် အဓိပ္ပာယ်တို့နှင့်တကွ လေ့လာနိုင်ပါသည်။`}
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": ["CollectionPage", "ItemList"],
			name: "မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်များ",
			url: new URL("/duas/", Astro.site).href,
			description: `နေ့စဉ်ဘဝအတွက် မရှိမဖြစ် ဒိုအာ ${duas.length} ခုကို အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် အဓိပ္ပာယ်တို့နှင့်တကွ လေ့လာနိုင်ပါသည်။`,
			inLanguage: ["my", "en", "ar"],
			numberOfItems: duas.length,
			itemListElement: duas.map((dua, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: dua.data.title_mm,
				url: new URL(`/duas/${dua.id}/`, Astro.site).href,
			})),
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "မူလစာမျက်နှာ",
						item: new URL("/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်များ",
						item: new URL("/duas/", Astro.site).href,
					},
				],
			},
		}}
	/>
	<PageHeader
		title="မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်များ"
		count={duas.length}
		sub="နေ့စဉ် ဆုတောင်းချက်များနှင့် ဇစ်ကိရ်များကို အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် အဓိပ္ပာယ်တို့နှင့်တကွ လေ့လာနိုင်ပါသည်။"
	/>

	<div data-filter-scope>
		<ListFilter
			label="ဒိုအာရှာဖွေရန်"
			placeholder="အမည် သို့မဟုတ် အဓိပ္ပာယ်ဖြင့် ရှာဖွေရန်…"
		/>

		<ul class="dua-list" data-filter-list>
			{
				duas.map((dua, index) => (
					<li data-filter-item>
						<a class="dua-row" href={`/duas/${dua.id}/`}>
							<span class="dua-row-number" aria-hidden="true">
								{index + 1}
							</span>
							<div class="dua-row-body">
								<span class="dua-row-title">{dua.data.title_mm}</span>
								<span class="dua-row-title-en" lang="en">
									{dua.data.title_en}
								</span>
							</div>
							<span class="dua-row-arabic" lang="ar" dir="rtl">
								{dua.data.arabic}
							</span>
							<span
								class="material-symbols-outlined dua-row-arrow"
								aria-hidden="true"
							>
								chevron_right
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<p class="filter-empty" data-filter-empty hidden>
			သင့်ရှာဖွေမှုနှင့် ကိုက်ညီသော ဒိုအာမတွေ့ပါ။
			<span lang="en">No duas found.</span>
		</p>
	</div>
</Layout>
