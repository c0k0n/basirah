---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const duas = (await getCollection("duas"))[0]?.data;
if (!duas) throw new Error("Essential duas content could not be loaded.");
---

<Layout
	title="Essential Duas & Dhikr | Hikmah"
	description="Essential daily duas and dhikr with Arabic, Burmese pronunciation, and Burmese and English meanings."
>
	<section class="page-hero page-hero--warm">
		<div class="shell narrow">
			<p class="section-kicker">الدُّعَاءُ وَالذِّكْرُ</p><h1>
				နေ့စဉ် ဒိုအာနှင့် ဇစ်ကိရ်
			</h1><p>
				နေ့စဉ်ဘဝ၏ အခိုက်အတန့်များတွင် အလ္လာဟ်အရှင်မြတ်အား အောက်မေ့ပြီး
				ဆုတောင်းရန် စုစည်းထားသော ဒိုအာများ။
			</p>
		</div>
	</section>
	<section class="shell content-section duas-section">
		<div class="library-toolbar">
			<p class="result-count">{duas.items.length} မရှိမဖြစ် ဒိုအာများ</p>
			<label class="search-field"
				><span class="sr-only">ဒိုအာ ရှာရန်</span><span
					aria-hidden="true">⌕</span
				><input
					type="search"
					placeholder="ဒိုအာ ရှာရန်..."
					data-search-input
				/></label
			>
		</div>
		<div class="dua-list" data-search-list>
			{
				duas.items.map((dua) => (
					<article
						class="dua-card"
						data-searchable={`${dua.title_mm} ${dua.title_en} ${dua.arabic} ${dua.burmese_meaning}`}
					>
						<div class="dua-card-header">
							<>
								<span class="dua-number">
									{String(dua.id).padStart(2, "0")}
								</span>
								<div>
									<>
										<h2>{dua.title_mm}</h2>
										<p>{dua.title_en}</p>
									</>
								</div>
							</>
						</div>
						<p class="arabic dua-arabic" lang="ar" dir="rtl">
							{dua.arabic}
						</p>
						<div class="dua-meaning">
							<>
								<p>
									<strong>အသံထွက်</strong>
									{dua.burmese_pronunciation}
								</p>
								<p>
									<strong>အဓိပ္ပာယ်</strong>
									{dua.burmese_meaning}
								</p>
							</>
						</div>
						<details>
							<>
								<summary>English meaning</summary>
								<p>{dua.english_meaning}</p>
							</>
						</details>
					</article>
				))
			}
		</div>
		<p class="empty-state" hidden data-empty-state>
			ရှာဖွေမှုနှင့် ကိုက်ညီသော ဒိုအာ မတွေ့ပါ။
		</p>
	</section>
	<script>
		const input = document.querySelector<HTMLInputElement>(
			"[data-search-input]",
		);
		const items = [
			...document.querySelectorAll<HTMLElement>("[data-searchable]"),
		];
		const empty = document.querySelector<HTMLElement>("[data-empty-state]");
		input?.addEventListener("input", () => {
			const term = input.value.trim().toLowerCase();
			let visible = 0;
			items.forEach((item) => {
				const matches =
					item.dataset.searchable?.toLowerCase().includes(term) ??
					false;
				item.hidden = !matches;
				if (matches) visible += 1;
			});
			if (empty) empty.hidden = visible !== 0;
		});
	</script>
</Layout>
