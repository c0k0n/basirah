---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ListFilter from "../../components/ListFilter.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";

const duas = (await getCollection("duas")).sort((a, b) => Number(a.id) - Number(b.id));
---

<Layout
	title="မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ် — Hikmah"
	description={`နေ့စဉ်ဘဝအတွက် မရှိမဖြစ် ဒိုအာ ${duas.length} ခုကို အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် အဓိပ္ပာယ်တို့နှင့်တကွ လေ့လာနိုင်ပါသည်။`}
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": ["CollectionPage", "ItemList"],
			name: "မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်",
			url: new URL("/duas/", Astro.site).href,
			description: `နေ့စဉ်ဘဝအတွက် မရှိမဖြစ် ဒိုအာ ${duas.length} ခုကို အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် အဓိပ္ပာယ်တို့နှင့်တကွ လေ့လာနိုင်ပါသည်။`,
			inLanguage: ["my", "en", "ar"],
			numberOfItems: duas.length,
			itemListElement: duas.map((dua, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: dua.data.title_mm,
				url: new URL(`/duas/${dua.id}/`, Astro.site).href,
			})),
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{ "@type": "ListItem", position: 1, name: "မူလစာမျက်နှာ", item: new URL("/", Astro.site).href },
					{
						"@type": "ListItem",
						position: 2,
						name: "မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်",
						item: new URL("/duas/", Astro.site).href,
					},
				],
			},
		}}
	/>
	<PageHeader
		title="မရှိမဖြစ် ဒိုအာများနှင့် ဇစ်ကိရ်"
		count={duas.length}
		sub="နေ့စဉ် ဆုတောင်းချက်များနှင့် ဇစ်ကိရ်များကို အာရဗီစာသား၊ မြန်မာအသံထွက်နှင့် အဓိပ္ပာယ်တို့နှင့်တကွ လေ့လာနိုင်ပါသည်။"
	/>

	<div data-filter-scope>
		<ListFilter label="ဒိုအာရှာဖွေရန်" placeholder="အမည် သို့မဟုတ် အဓိပ္ပာယ်ဖြင့် ရှာဖွေရန်…" />

		<div class="card-grid" data-filter-list>
			{
				duas.map((dua, index) => (
					<a class="card dua-card" data-filter-item href={`/duas/${dua.id}`}>
						<div class="dua-card-top">
							<span class="surah-number" aria-hidden="true">{index + 1}</span>
							<span class="material-symbols-outlined" aria-hidden="true">favorite</span>
						</div>
						<span class="dua-title" lang="my">{dua.data.title_mm}</span>
						<span class="dua-title-mm" lang="en">{dua.data.title_en}</span>
						<span class="dua-arabic-snippet" lang="ar" dir="rtl">{dua.data.arabic}</span>
					</a>
				))
			}
			<p class="filter-empty" data-filter-empty hidden>
				<span lang="my">သင့်ရှာဖွေမှုနှင့် ကိုက်ညီသော ဒိုအာမတွေ့ပါ။</span>
				<span lang="en">No duas found.</span>
			</p>
		</div>
	</div>
</Layout>