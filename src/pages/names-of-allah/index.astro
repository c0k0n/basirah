---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ListFilter from "../../components/ListFilter.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";
import { truncate } from "../../utils/truncate";

const names = (await getCollection("names")).sort(
	(a, b) => a.data.number - b.data.number,
);
const meta = names[0]!.data.meta;
// SEO: keep meta description within ~150 chars for clean SERP snippets.
// Content file is read-only; truncate here with word-aware helper.
const metaDescription = truncate(meta.summary_burmese, 150);
---

<Layout title={`${meta.title_burmese} — Basirah`} description={metaDescription}>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": ["CollectionPage", "ItemList"],
			name: meta.title_burmese,
			alternateName: meta.title_transliteration,
			url: new URL("/names-of-allah/", Astro.site).href,
			description: metaDescription,
			inLanguage: ["my", "en", "ar"],
			numberOfItems: names.length,
			itemListElement: names.map((name) => ({
				"@type": "ListItem",
				position: name.data.number,
				name: `${name.data.transliteration} (${name.data.english_meaning})`,
				url: new URL(`/names-of-allah/#name-${name.data.number}`, Astro.site)
					.href,
			})),
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "မူလစာမျက်နှာ",
						item: new URL("/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "အလ္လာဟ်၏ နာမတော်များ",
						item: new URL("/names-of-allah/", Astro.site).href,
					},
				],
			},
		}}
	/>
	<PageHeader
		title={meta.title_burmese}
		arabic={meta.title_arabic}
		count={names.length}
		sub={meta.summary_burmese}
	/>

	<section
		data-filter-scope
		aria-label="အလ္လာဟ်၏ နာမတော်များကို ရှာဖွေရန်နှင့် ကြည့်ရှုရန်"
	>
		<ListFilter
			id="names"
			label="နာမတော်ရှာဖွေရန်"
			placeholder="အာရဗီ၊ အသံထွက် သို့မဟုတ် အဓိပ္ပာယ်ဖြင့် ရှာဖွေရန်…"
		/>

		<section
			class="name-table-wrap"
			data-filter-list
			aria-label="အလ္လာဟ်၏ နာမတော်များ စာရင်း"
		>
			<table class="name-table">
				<caption class="visually-hidden">
					{meta.title_burmese}
				</caption>
				<thead>
					<tr>
						<th scope="col" class="name-col-num">စဉ်</th>
						<th scope="col">အမည်</th>
						<th scope="col">အသံထွက်</th>
						<th scope="col">အဓိပ္ပာယ်</th>
					</tr>
				</thead>
				<tbody>
					{
						names.map((name) => (
							<tr id={`name-${name.data.number}`} data-filter-item>
								<th scope="row" class="name-col-num" data-label="စဉ်">
									{name.data.number}
								</th>
								<td
									class="name-cell-arabic"
									data-label="အမည်"
									lang="ar"
									dir="rtl"
								>
									{name.data.arabic}
								</td>
								<td class="name-cell-pronunciation" data-label="အသံထွက်">
									<span>{name.data.burmese_transliteration}</span>
									<span lang="en">{name.data.transliteration}</span>
								</td>
								<td class="name-cell-meaning" data-label="အဓိပ္ပာယ်">
									<span>{name.data.burmese_meaning}</span>
									<span lang="en">{name.data.english_meaning}</span>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="filter-empty" data-filter-empty hidden>
				သင့်ရှာဖွေမှုနှင့် ကိုက်ညီသော နာမတော်မတွေ့ပါ။
				<span lang="en">No names found.</span>
			</p>
		</section>
	</section>
</Layout>
