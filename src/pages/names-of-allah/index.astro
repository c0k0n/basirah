---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ListFilter from "../../components/ListFilter.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";
import namesData from "../../assets/content/allah-names/names.json";

const names = (await getCollection("names")).sort(
	(a, b) => a.data.number - b.data.number,
);
const metadata = namesData.metadata;
---

<Layout
	title={`${metadata.title_burmese} — Hikmah`}
	description={metadata.summary_burmese}
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": ["CollectionPage", "ItemList"],
			name: metadata.title_burmese,
			alternateName: metadata.title_transliteration,
			url: new URL("/names-of-allah/", Astro.site).href,
			description: metadata.summary_burmese,
			inLanguage: ["my", "en", "ar"],
			numberOfItems: names.length,
			itemListElement: names.map((name) => ({
				"@type": "ListItem",
				position: name.data.number,
				name: `${name.data.transliteration} (${name.data.english_meaning})`,
			})),
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "မူလစာမျက်နှာ",
						item: new URL("/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "အလ္လာဟ်၏ နာမတော်များ",
						item: new URL("/names-of-allah/", Astro.site).href,
					},
				],
			},
		}}
	/>
	<PageHeader
		title={metadata.title_burmese}
		arabic={metadata.title_arabic}
		count={names.length}
		sub={metadata.summary_burmese}
	/>

	<div data-filter-scope>
		<ListFilter
			label="နာမတော်ရှာဖွေရန်"
			placeholder="အာရဗီ၊ အသံထွက် သို့မဟုတ် အဓိပ္ပာယ်ဖြင့် ရှာဖွေရန်…"
		/>

		<div class="name-table-wrap" data-filter-list>
			<table class="name-table">
				<caption class="visually-hidden" lang="my">
					{metadata.title_burmese}
				</caption>
				<thead>
					<tr>
						<th scope="col" class="name-col-num">
							<span lang="my">စဉ်</span>
						</th>
						<th scope="col">
							<span lang="my">အမည်</span>
						</th>
						<th scope="col">
							<span lang="my">အသံထွက်</span>
						</th>
						<th scope="col">
							<span lang="my">အဓိပ္ပာယ်</span>
						</th>
					</tr>
				</thead>
				<tbody>
					{
						names.map((name) => (
							<tr data-filter-item>
								<th scope="row" class="name-col-num">
									{name.data.number}
								</th>
								<td class="name-cell-arabic" lang="ar" dir="rtl">
									{name.data.arabic}
								</td>
								<td class="name-cell-pronunciation">
									<span lang="my">{name.data.burmese_transliteration}</span>
									<span lang="en">{name.data.transliteration}</span>
								</td>
								<td class="name-cell-meaning">
									<span lang="my">{name.data.burmese_meaning}</span>
									<span lang="en">{name.data.english_meaning}</span>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="filter-empty" data-filter-empty hidden>
				<span lang="my">သင့်ရှာဖွေမှုနှင့် ကိုက်ညီသော နာမတော်မတွေ့ပါ။</span>
				<span lang="en">No names found.</span>
			</p>
		</div>
	</div>
</Layout>
