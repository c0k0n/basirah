---
import Layout from "../../layouts/Layout.astro";
import AudioPlayer from "../../components/AudioPlayer.astro";
import SurahJumpDialog from "../../components/SurahJumpDialog.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { truncate } from "../../utils/truncate";

interface NavEntry {
	id: string;
	name: string;
}

interface Props {
	surah: CollectionEntry<"surahs">;
	prev: NavEntry | null;
	next: NavEntry | null;
	audioUrl: string | null;
	allSurahs: CollectionEntry<"surahs">[];
}

type SurahVerse = CollectionEntry<"surahs">["data"]["verses"][number];

export async function getStaticPaths() {
	// Recitation files live in src/assets and are bundled by Astro at build
	// time, which hashes their URLs (/_astro/...) for immutable caching.
	const audioFiles = import.meta.glob("../../assets/audio/surahs/*.opus", {
		eager: true,
		query: "?url",
		import: "default",
	}) as Record<string, string>;
	const audioBySurahId = new Map(
		Object.entries(audioFiles).map(([path, url]) => [
			path
				.split("/")
				.at(-1)!
				.replace(/\.opus$/, ""),
			url,
		]),
	);
	const surahs = (await getCollection("surahs")).sort(
		(a, b) =>
			a.data.surah_metadata.surah_number - b.data.surah_metadata.surah_number,
	);
	return surahs.map((surah, index) => {
		const prevEntry = surahs[index - 1];
		const nextEntry = surahs[index + 1];
		return {
			params: { surah: surah.id },
			props: {
				surah,
				prev: prevEntry
					? {
							id: prevEntry.id,
							name: prevEntry.data.surah_metadata.name_transliteration,
						}
					: null,
				next: nextEntry
					? {
							id: nextEntry.id,
							name: nextEntry.data.surah_metadata.name_transliteration,
						}
					: null,
				audioUrl: audioBySurahId.get(surah.id) ?? null,
				allSurahs: surahs,
			},
		};
	});
}

const { surah, prev, next, audioUrl, allSurahs } = Astro.props;
const meta = surah.data.surah_metadata;
const bismillah = surah.data.bismillah;
const prostration = meta.prostration_verse;
// Keep SEO description within ~155 chars to avoid SERP truncation (word-aware).
const rawDescription = `စူရဟ် ${meta.name_transliteration} — ${meta.meaning_of_title.burmese}။ ${meta.revelation_place.burmese}၌ ကျရောက်သော စူရဟ်ဖြစ်ပြီး အာယသ် ${meta.total_verses} ပါဝင်ကာ မြန်မာဘာသာပြန်၊ အသံထွက်နှင့် ရွတ်ဖတ်သံတို့ ပါဝင်ပါသည်။`;
const seoDescription = truncate(rawDescription, 155);
---

<Layout
	title={`${meta.name_transliteration} (${meta.surah_number}) — Basirah`}
	description={seoDescription}
	ogType="article"
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": "WebPage",
			name: `Surah ${meta.name_transliteration} (${meta.surah_number})`,
			url: new URL(`/surahs/${surah.id}/`, Astro.site).href,
			description: seoDescription,
			inLanguage: ["my", "en", "ar"],
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "မူလစာမျက်နှာ",
						item: new URL("/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "မရှိမဖြစ် စူရဟ်များ",
						item: new URL("/surahs/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 3,
						name: `စူရဟ် ${meta.name_transliteration}`,
						item: new URL(`/surahs/${surah.id}/`, Astro.site).href,
					},
				],
			},
			...(audioUrl && {
				audio: {
					"@type": "AudioObject",
					name: `စူရဟ် ${meta.name_transliteration} — ရွတ်ဖတ်သံ`,
					contentUrl: new URL(audioUrl, Astro.site).href,
					encodingFormat: "audio/opus",
					inLanguage: "ar",
				},
			}),
		}}
	/>
	<div class="surah-top-bar">
		<a class="back-link" href="/surahs/">
			<span class="material-symbols-outlined" aria-hidden="true"
				>arrow_back</span
			>
			စူရဟ်အားလုံး
			<span lang="en">· All surahs</span>
		</a>
		<button
			class="quick-trigger"
			type="button"
			data-quick-open
			aria-label="စူရဟ်ရွေးချယ်ရန် · Jump to surah"
		>
			<span class="material-symbols-outlined" aria-hidden="true">menu_book</span
			>
			<span>စူရဟ်ရွေးရန်</span>
			<span lang="en">· Jump</span>
		</button>
	</div>

	<header class="surah-hero">
		<span class="surah-hero-number">စူရဟ် {meta.surah_number}</span>
		<h1 lang="ar" dir="rtl">
			{meta.name_arabic}
			<span class="visually-hidden">
				({" "}
				{meta.name_transliteration}
				{" · "}
				{meta.name_burmese_title}
				{" "})
			</span>
		</h1>
		<p class="surah-hero-translit">
			<span lang="en">{meta.name_transliteration}</span>
			· {meta.name_burmese_title}
		</p>
		<p class="surah-hero-summary">{meta.summary_burmese}</p>
		<dl class="surah-meta">
			<div class="surah-meta-item">
				<dt>
					<span class="surah-meta-icon" aria-hidden="true">
						<span class="material-symbols-outlined">translate</span>
					</span>
					အဓိပ္ပာယ်
				</dt>
				<dd>
					<span>{meta.meaning_of_title.burmese}</span>
					<span class="surah-meta-en" lang="en">
						{meta.meaning_of_title.english}
					</span>
				</dd>
			</div>
			<div class="surah-meta-item">
				<dt>
					<span class="surah-meta-icon" aria-hidden="true">
						<span class="material-symbols-outlined">location_on</span>
					</span>
					ကျရောက်ရာနေရာ
				</dt>
				<dd>
					<span>{meta.revelation_place.burmese}</span>
					<span class="surah-meta-en" lang="en">
						{meta.revelation_place.english}
					</span>
				</dd>
			</div>
			<div class="surah-meta-item">
				<dt>
					<span class="surah-meta-icon" aria-hidden="true">
						<span class="material-symbols-outlined">123</span>
					</span>
					အာယသ်
				</dt>
				<dd>{meta.total_verses}</dd>
			</div>
			<div class="surah-meta-item">
				<dt>
					<span class="surah-meta-icon" aria-hidden="true">
						<span class="material-symbols-outlined">format_list_numbered</span>
					</span>
					ကျရောက်သည့်အစီအစဉ်
				</dt>
				<dd>{meta.revelation_order}</dd>
			</div>
		</dl>
	</header>

	{
		audioUrl && (
			<div class="audio-player-wrap" data-audio-wrap>
				<AudioPlayer src={audioUrl} title={meta.name_transliteration} />
			</div>
		)
	}

	<section class="bismillah" aria-label="ဗစ်မီလ္လာဟ်">
		<h2 class="visually-hidden">ဗစ်မီလ္လာဟ်</h2>
		<p class="bismillah-arabic" lang="ar" dir="rtl">{bismillah.arabic}</p>
		<div
			class="bismillah-translations"
			role="group"
			aria-label="ဗစ်မီလ္လာဟ် ဘာသာပြန်များ"
		>
			<p>{bismillah.burmese_transliteration}</p>
			<p lang="en">{bismillah.english_translation}</p>
			<p>{bismillah.burmese_translation}</p>
		</div>
	</section>

	<h2 id="verse-title" class="verse-section-title">အာယသ်များ</h2>
	<ol class="verse-list" data-verse-observe aria-labelledby="verse-title">
		{
			surah.data.verses.map((verse: SurahVerse) => (
				<li class="verse">
					<header class="verse-head">
						<span class="verse-number">အာယသ် {verse.verse_number}</span>
						{verse.arabic_marker && (
							<span class="verse-prostration" lang="ar" dir="rtl">
								{verse.arabic_marker} سَجْدَة
							</span>
						)}
					</header>
					<p class="verse-arabic" lang="ar" dir="rtl">
						{verse.arabic}
					</p>
					<p class="verse-translit">{verse.burmese_transliteration}</p>
					<p class="verse-english" lang="en">
						{verse.english_translation}
					</p>
					<p class="verse-burmese">{verse.burmese_translation}</p>
					{verse.note && (
						<details class="verse-note">
							<summary>
								မှတ်ချက် / <span lang="en">Note</span>
							</summary>
							<p>{verse.note}</p>
						</details>
					)}
				</li>
			))
		}
	</ol>

	{prostration && <p class="verse-note">{prostration.note_burmese}</p>}

	<nav class="pager" aria-label="စူရဟ်များအကြား သွားရန်">
		{
			prev && (
				<a href={`/surahs/${prev.id}/`} rel="prev">
					<span class="pager-label">
						<span class="material-symbols-outlined" aria-hidden="true">
							chevron_left
						</span>
						ရှေ့စူရဟ်
					</span>
					<span class="pager-name" lang="en">
						{prev.name}
					</span>
				</a>
			)
		}
		{
			next && (
				<a class="pager-next" href={`/surahs/${next.id}/`} rel="next">
					<span class="pager-label">
						နောက်စူရဟ်
						<span class="material-symbols-outlined" aria-hidden="true">
							chevron_right
						</span>
					</span>
					<span class="pager-name" lang="en">
						{next.name}
					</span>
				</a>
			)
		}
	</nav>

	<div class="quick-nav-bar">
		<button
			class="quick-trigger quick-trigger--center"
			type="button"
			data-quick-open
			aria-label="စူရဟ်စာရင်းမှ ရွေးချယ်ရန် · Choose from list"
		>
			<span class="material-symbols-outlined" aria-hidden="true"
				>format_list_numbered</span
			>
			<span>စူရဟ်စာရင်းမှ ရွေးရန်</span>
			<span lang="en">· All {allSurahs.length}</span>
		</button>
	</div>

	<SurahJumpDialog surahs={allSurahs} currentId={surah.id} />

	<script>
		const wrap = document.querySelector<HTMLElement>("[data-audio-wrap]");
		const player = document.querySelector<HTMLElement>("[data-audio-player]");
		const verses = document.querySelector<HTMLElement>("[data-verse-observe]");
		const docEl = document.documentElement;

		if (wrap && player && verses && "IntersectionObserver" in window) {
			let isFloating = false;
			let versesVisible = false;
			let wrapVisible = true;
			let resizeTimer: number | undefined;

			const setFloating = (shouldFloat: boolean) => {
				if (shouldFloat === isFloating) return;
				isFloating = shouldFloat;

				if (shouldFloat) {
					const height = player.offsetHeight;
					wrap.style.height = `${height}px`;
					player.classList.add("is-floating");
					docEl.classList.add("has-floating-audio");
				} else {
					player.classList.remove("is-floating");
					docEl.classList.remove("has-floating-audio");
					wrap.style.height = "";
				}
			};

			const update = () => {
				// Floating while verses are in viewport but the original
				// inline player has scrolled out of view. This prevents an
				// immediate dock on large viewports where the first ayat is
				// already visible at load, and matches the quran.com pattern
				// where the dock appears after the hero/bismillah scroll past.
				const shouldFloat = versesVisible && !wrapVisible;
				setFloating(shouldFloat);
			};

			const versesObserver = new IntersectionObserver(
				(entries) => {
					const entry = entries[0];
					if (!entry) return;
					versesVisible = entry.isIntersecting;
					update();
				},
				{ threshold: 0 },
			);

			const wrapObserver = new IntersectionObserver(
				(entries) => {
					const entry = entries[0];
					if (!entry) return;
					wrapVisible = entry.isIntersecting;
					update();
				},
				{ threshold: 0 },
			);

			versesObserver.observe(verses);
			wrapObserver.observe(wrap);

			const onResize = () => {
				if (!isFloating) return;
				window.clearTimeout(resizeTimer);
				resizeTimer = window.setTimeout(() => {
					wrap.style.height = `${player.offsetHeight}px`;
				}, 100);
			};

			window.addEventListener("resize", onResize, { passive: true });
		}
	</script>
</Layout>
