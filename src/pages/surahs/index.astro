---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ListFilter from "../../components/ListFilter.astro";
import SurahCard from "../../components/SurahCard.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection } from "astro:content";

const surahs = (await getCollection("surahs")).sort(
	(a, b) =>
		a.data.surah_metadata.surah_number - b.data.surah_metadata.surah_number,
);
---

<Layout
	title="မရှိမဖြစ် စူရဟ်များ — Basirah"
	description={`ကုရ်အာန်၏ မရှိမဖြစ် စူရဟ် ${surahs.length} စူရဟ်ကို မြန်မာဘာသာပြန်၊ အသံထွက်နှင့် ရွတ်ဖတ်သံများနှင့်တကွ ဖတ်ရှုနားထောင်နိုင်ပါသည်။`}
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": ["CollectionPage", "ItemList"],
			name: "မရှိမဖြစ် စူရဟ်များ",
			url: new URL("/surahs/", Astro.site).href,
			description: `ကုရ်အာန်၏ မရှိမဖြစ် စူရဟ် ${surahs.length} စူရဟ်ကို မြန်မာဘာသာပြန်၊ အသံထွက်နှင့် ရွတ်ဖတ်သံများနှင့်တကွ ဖတ်ရှုနားထောင်နိုင်ပါသည်။`,
			inLanguage: ["my", "en", "ar"],
			numberOfItems: surahs.length,
			itemListElement: surahs.map((surah, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: `Surah ${surah.data.surah_metadata.name_transliteration}`,
				url: new URL(`/surahs/${surah.id}/`, Astro.site).href,
			})),
			breadcrumb: {
				"@type": "BreadcrumbList",
				itemListElement: [
					{
						"@type": "ListItem",
						position: 1,
						name: "မူလစာမျက်နှာ",
						item: new URL("/", Astro.site).href,
					},
					{
						"@type": "ListItem",
						position: 2,
						name: "မရှိမဖြစ် စူရဟ်များ",
						item: new URL("/surahs/", Astro.site).href,
					},
				],
			},
		}}
	/>
	<PageHeader
		title="မရှိမဖြစ် စူရဟ်များ"
		arabic="السُّوَر"
		count={surahs.length}
		stacked
		sub={`စူရဟ် ${surahs.length} စူရဟ်ကို မြန်မာဘာသာပြန်၊ အသံထွက်နှင့် ရွတ်ဖတ်သံများနှင့်တကွ ဖတ်ရှုနားထောင်နိုင်ပါသည်။`}
	/>

	<div data-filter-scope>
		<ListFilter
			label="စူရဟ်ရှာဖွေရန်"
			placeholder="အမည် သို့မဟုတ် အဓိပ္ပာယ်ဖြင့် ရှာဖွေရန်…"
		/>

		<div class="surah-grid" data-filter-list>
			{surahs.map((surah) => <SurahCard surah={surah} />)}
			<p class="filter-empty" data-filter-empty hidden>
				<span lang="my">သင့်ရှာဖွေမှုနှင့် ကိုက်ညီသော စူရဟ်မတွေ့ပါ။</span>
				<span lang="en">No surahs found.</span>
			</p>
		</div>
	</div>
</Layout>
