---
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="ခေတ္တအဆင်မပြေပါ — Basirah"
	description="Basirah တွင် ခေတ္တအဆင်မပြေမှုတစ်ခု ဖြစ်ပေါ်နေပါသည်။"
	noindex
>
	<section class="not-found server-error" aria-labelledby="server-error-title">
		<p class="not-found-code" lang="en" aria-hidden="true">500</p>
		<span class="material-symbols-outlined not-found-icon" aria-hidden="true"
			>close</span
		>
		<h1 id="server-error-title">ခေတ္တအဆင်မပြေပါ</h1>
		<p class="hero-tagline">
			တောင်းပန်ပါသည် — ဆာဗာတွင် ခေတ္တအဆင်မပြေမှုတစ်ခု ဖြစ်ပေါ်နေပါသည်။
		</p>
		<p class="hero-sub" lang="en">
			Please try again in a moment, or continue from one of these pages.
		</p>
		<nav class="not-found-actions" aria-label="အခြားစာမျက်နှာများသို့ သွားရန်">
			<a class="btn" href="/">
				<span class="material-symbols-outlined" aria-hidden="true">home</span>
				မူလစာမျက်နှာသို့ ပြန်သွားရန်
			</a>
			<a class="btn btn-secondary" href="/surahs/">
				ကုရ်အာန် စူရာများကို ကြည့်ရန်
				<span class="material-symbols-outlined" aria-hidden="true"
					>arrow_forward</span
				>
			</a>
		</nav>
	</section>
</Layout>
