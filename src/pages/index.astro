---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const [surahs, duas, names] = await Promise.all([
	getCollection("surahs"),
	getCollection("duas"),
	getCollection("names"),
]);
const orderedSurahs = surahs.sort(
	(a, b) =>
		a.data.surah_metadata.surah_number - b.data.surah_metadata.surah_number,
);
const featured =
	orderedSurahs.find(
		(surah) => surah.data.surah_metadata.surah_number === 1,
	) ?? orderedSurahs[0];
const duaCount = duas[0]?.data.items.length ?? 0;
const nameCount = names[0]?.data.names.length ?? 0;
---

<Layout
	title="Hikmah — Islamic knowledge in Burmese"
	description="A calm, accessible Islamic knowledge library in Burmese: selected Surahs, essential duas, and the beautiful names of Allah."
>
	<section class="hero">
		<div class="shell hero-grid">
			<div class="hero-copy">
				<p class="eyebrow">بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ</p>
				<h1>သင်ယူမှုတိုင်းမှာ <em>အလင်း</em> ရှိပါစေ</h1>
				<p class="hero-intro">
					ကုရ်အာန်၊ ဒိုအာနှင့် အလ္လာဟ်အရှင်မြတ်၏ နာမတော်များကို
					မြန်မာဘာသာဖြင့် အေးချမ်းစွာ လေ့လာနိုင်ရန် စုစည်းထားသော
					စာကြည့်တိုက်တစ်ခုပါ။
				</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/surahs/"
						>ကုရ်အာန် ဖတ်ရှုရန် <span aria-hidden="true">→</span></a
					>
					<a class="text-link" href="/duas/"
						>နေ့စဉ် ဒိုအာများ <span aria-hidden="true">↗</span></a
					>
				</div>
			</div>
			<aside class="hero-verse" aria-label="A verse from the Quran">
				<span class="verse-ornament" aria-hidden="true">۞</span>
				<p class="arabic hero-arabic" lang="ar" dir="rtl">
					{featured.data.verses[0]?.arabic}
				</p>
				<p class="verse-translation">
					{featured.data.verses[0]?.burmese_translation}
				</p>
				<a href={`/surahs/${featured.id}/`}
					>စူရဟ် {featured.data.surah_metadata.name_transliteration}
					<span aria-hidden="true">→</span></a
				>
			</aside>
		</div>
	</section>

	<section class="shell stats" aria-label="Library contents">
		<div>
			<strong>{orderedSurahs.length}</strong><span
				>ရွေးချယ်ထားသော စူရဟ်များ</span
			>
		</div>
		<div><strong>{duaCount}</strong><span>မရှိမဖြစ် ဒိုအာများ</span></div>
		<div>
			<strong>{nameCount}</strong><span
				>အလ္လာဟ်အရှင်မြတ်၏ နာမတော်များ</span
			>
		</div>
	</section>

	<section class="shell section-space">
		<div class="section-heading">
			<div>
				<p class="section-kicker">စတင်လေ့လာရန်</p><h2>
					သင့်အတွက် စုစည်းထားသော လမ်းကြောင်းများ
				</h2>
			</div>
			<p>
				လေ့လာလိုသည့် အကြောင်းအရာကို လွယ်ကူစွာ ရွေးချယ်ပြီး
				မိမိအရှိန်အဟုန်ဖြင့် ဆက်လက်ဖတ်ရှုနိုင်ပါသည်။
			</p>
		</div>
		<div class="resource-grid">
			<a class="resource-card resource-card--quran" href="/surahs/">
				<span class="resource-symbol" aria-hidden="true">۝</span>
				<span class="resource-number">01</span>
				<h3>ကုရ်အာန် ကျမ်းတော်မြတ်</h3>
				<p>
					အာရဗီစာသား၊ မြန်မာဘာသာပြန်၊ အသံဖိုင်နှင့်အတူ ရွေးချယ်ထားသော
					စူရဟ်များကို ဖတ်ရှုနားဆင်ပါ။
				</p>
				<span class="card-link"
					>စူရဟ်များသို့ <b aria-hidden="true">→</b></span
				>
			</a>
			<a class="resource-card resource-card--dua" href="/duas/">
				<span class="resource-symbol" aria-hidden="true">۩</span>
				<span class="resource-number">02</span>
				<h3>နေ့စဉ် ဒိုအာနှင့် ဇစ်ကိရ်</h3>
				<p>
					ဝတ်ပြုခြင်း၊ ခွင့်လွှတ်မှုနှင့် ဘဝအခိုက်အတန့်များအတွက်
					အဓိပ္ပာယ်ပါသော ဒိုအာများ။
				</p>
				<span class="card-link"
					>ဒိုအာများသို့ <b aria-hidden="true">→</b></span
				>
			</a>
			<a class="resource-card resource-card--names" href="/names/">
				<span class="resource-symbol" aria-hidden="true">ٱ</span>
				<span class="resource-number">03</span>
				<h3>အလှပဆုံး နာမတော်များ</h3>
				<p>
					အလ္လာဟ်အရှင်မြတ်၏ ဂုဏ်တော်များကို နားလည်ပြီး ဆုတောင်းရာတွင်
					အနီးကပ် ချဉ်းကပ်ပါ။
				</p>
				<span class="card-link"
					>နာမတော်များသို့ <b aria-hidden="true">→</b></span
				>
			</a>
		</div>
	</section>

	<section class="shell reflection section-space">
		<div class="reflection-copy">
			<p class="section-kicker">ယနေ့၏ အောက်မေ့ဖွယ်</p>
			<h2>ဖတ်ရှုခြင်းမှ နားလည်မှုသို့</h2>
			<p>
				အသိပညာသည် စာမျက်နှာတစ်ခုတည်းတွင် မဆုံးပါ။ စိတ်ထဲသို့
				ထည့်သွင်းခြင်း၊ ပြန်လည်အောက်မေ့ခြင်းနှင့် နေ့စဉ်ဘဝတွင်
				အသုံးချခြင်းတို့ဖြင့် အဓိပ္ပာယ်ပြည့်စုံလာပါသည်။
			</p>
		</div>
		<blockquote>
			<p lang="ar" dir="rtl" class="arabic">رَبِّ زِدْنِي عِلْمًا</p>
			<cite
				>“အို အကျွန်ုပ်၏အရှင်၊ အကျွန်ုပ်၏ အသိပညာကို တိုးပွားစေတော်မူပါ။”</cite
			>
		</blockquote>
	</section>
</Layout>
