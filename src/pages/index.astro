---
import Layout from "../layouts/Layout.astro";
import JsonLd from "../components/JsonLd.astro";
import { getCollection } from "astro:content";

const surahCount = (await getCollection("surahs")).length;
const duaCount = (await getCollection("duas")).length;
const nameCount = (await getCollection("names")).length;
---

<Layout
	title="Basirah — ကုရ်အာန်နှင့် စွန္နသ်မှ အသိပညာ ဗဟုသုတ"
	description="ကုရ်အာန်နှင့် စွန္နသ်မှ အသိပညာ ဗဟုသုတများကို မြန်မာဘာသာဖြင့် လေ့လာနိုင်သော မရှိမဖြစ် စူရဟ်များ၊ ဒိုအာများနှင့် အလ္လာဟ်အရှင်မြတ်၏ အလှပဆုံး နာမတော်များ။"
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "Basirah",
			alternateName: "ဗဆီရဟ်",
			url: new URL("/", Astro.site).href,
			inLanguage: ["my", "en", "ar"],
			description:
				"ကုရ်အာန်နှင့် စွန္နသ်မှ အသိပညာ ဗဟုသုတများကို မြန်မာဘာသာဖြင့် လေ့လာနိုင်သော မရှိမဖြစ် စူရဟ်များ၊ ဒိုအာများနှင့် အလ္လာဟ်အရှင်မြတ်၏ အလှပဆုံး နာမတော်များ။",
		}}
	/>
	<section class="hero">
		<h1 class="hero-brand">
			<span class="hero-name" lang="en">Basirah</span>
			<span class="hero-arabic isolated-rtl" lang="ar">بَصِيرَة</span>
			<span class="hero-burmese">ဗဆီရဟ်</span>
		</h1>
		<p class="hero-tagline">
			ကုရ်အာန်နှင့် စွန္နသ်တော်မှ အသိပညာ ဗဟုသုတများကို ရှင်းလင်းသော
			မြန်မာဘာသာဖြင့် လေ့လာပါ။
		</p>
		<p class="hero-intro">
			မရှိမဖြစ် စူရဟ်များ (အသံဖတ်ကြားချက်နှင့်တကွ)၊ နေ့စဉ်ဘဝအတွက် ဒိုအာများနှင့်
			အလ္လာဟ်အရှင်မြတ်၏ အလှပဆုံး နာမတော် (၁၀၀) ပါးတို့ကို တစ်နေရာတည်းတွင်
			စုစည်းထားပါသည်။
		</p>
		<p class="hero-sub" lang="en">
			Basirah gathers the wisdom of the Qur'an and Sunnah into clear, accessible
			Burmese — essential surahs with recitation audio, duas for daily life, and
			the beautiful names of Allah, all in one place, for Myanmar Muslims.
		</p>
	</section>

	<section class="container" aria-label="Basirah ကို လေ့လာရန်">
		<ul class="card-grid">
			<li>
				<a class="card" href="/surahs/">
					<div class="card-top">
						<span class="card-icon material-symbols-outlined" aria-hidden="true"
							>book</span
						>
						<span class="card-count">{surahCount}</span>
					</div>
					<h2 class="card-title">
						<span class="card-title-burmese">စူရဟ်များ</span>
						<span class="card-title-en" lang="en">Surahs</span>
					</h2>
					<p class="card-desc">
						မြန်မာဘာသာပြန်နှင့် အသံဖြင့် ဖတ်ရှုနားထောင်နိုင်သော အခြေခံစူရဟ်များ။
					</p>
					<div class="card-cta">
						လေ့လာရန်
						<span class="material-symbols-outlined" aria-hidden="true"
							>arrow_forward</span
						>
					</div>
				</a>
			</li>

			<li>
				<a class="card" href="/duas/">
					<div class="card-top">
						<span class="card-icon material-symbols-outlined" aria-hidden="true"
							>favorite</span
						>
						<span class="card-count">{duaCount}</span>
					</div>
					<h2 class="card-title">
						<span class="card-title-burmese">ဒိုအာများ</span>
						<span class="card-title-en" lang="en">Duas</span>
					</h2>
					<p class="card-desc">
						နေ့စဉ်ဘဝအတွက် မရှိမဖြစ် ဒိုအာများကို အဓိပ္ပာယ်နှင့်တကွ။
					</p>
					<div class="card-cta">
						လေ့လာရန်
						<span class="material-symbols-outlined" aria-hidden="true"
							>arrow_forward</span
						>
					</div>
				</a>
			</li>

			<li>
				<a class="card" href="/names-of-allah/">
					<div class="card-top">
						<span class="card-icon material-symbols-outlined" aria-hidden="true"
							>star</span
						>
						<span class="card-count">{nameCount}</span>
					</div>
					<h2 class="card-title">
						<span class="card-title-burmese">အလ္လာဟ်၏ နာမတော်များ</span>
						<span class="card-title-en" lang="en">Names of Allah</span>
					</h2>
					<p class="card-desc">
						အလ္လာဟ်အရှင်မြတ်၏ အလှပဆုံး နာမတော် (၁၀၀) ပါးကို အဓိပ္ပာယ်နှင့်တကွ။
					</p>
					<div class="card-cta">
						လေ့လာရန်
						<span class="material-symbols-outlined" aria-hidden="true"
							>arrow_forward</span
						>
					</div>
				</a>
			</li>
		</ul>
	</section>
</Layout>

<style>
	.hero-brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.55rem;
	}

	.hero-name {
		font-family: var(--font-serif);
		font-size: clamp(2.75rem, 6vw, 4.25rem);
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.hero-arabic {
		display: block;
		font-size: clamp(2rem, 4.5vw, 3rem);
		line-height: 1.5;
		color: var(--accent);
	}

	.hero-burmese {
		display: block;
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text-muted);
		letter-spacing: 0.04em;
	}

	.hero-intro {
		margin-top: 0.75rem;
		color: var(--text-muted);
		max-width: 42rem;
		margin-inline: auto;
		line-height: 1.7;
	}
</style>
