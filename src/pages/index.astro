---
import Layout from "../layouts/Layout.astro";
import JsonLd from "../components/JsonLd.astro";
import { getCollection } from "astro:content";

const surahCount = (await getCollection("surahs")).length;
const duaCount = (await getCollection("duas")).length;
const nameCount = (await getCollection("names")).length;
---

<Layout
	title="Hikmah — ကုရ်အာန်နှင့် စွန္နသ်မှ ဉာဏ်ပညာ"
	description="ကုရ်အာန်နှင့် စွန္နသ်မှ ဉာဏ်ပညာများကို မြန်မာဘာသာဖြင့် လေ့လာနိုင်သော မရှိမဖြစ် စူရဟ်များ၊ ဒိုအာများနှင့် အလ္လာဟ်အရှင်မြတ်၏ အလှပဆုံး နာမတော်များ။"
>
	<JsonLd
		data={{
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: "Hikmah",
			alternateName: "ဟစ်ခ်မဟ်",
			url: new URL("/", Astro.site).href,
			inLanguage: ["my", "en", "ar"],
			description:
				"ကုရ်အာန်နှင့် စွန္နသ်မှ ဉာဏ်ပညာများကို မြန်မာဘာသာဖြင့် လေ့လာနိုင်သော မရှိမဖြစ် စူရဟ်များ၊ ဒိုအာများနှင့် အလ္လာဟ်အရှင်မြတ်၏ အလှပဆုံး နာမတော်များ။",
		}}
	/>
	<section class="hero">
		<h1>
			Hikmah <span class="hero-arabic isolated-rtl" lang="ar">حِكْمَة</span>
			<span lang="my">ဟစ်ခ်မဟ်</span>
		</h1>
		<p class="hero-tagline" lang="my">
			ကုရ်အာန်နှင့် စွန္နသ်မှ ဉာဏ်ပညာများကို မြန်မာဘာသာဖြင့် လေ့လာပါ။
		</p>
		<p class="hero-sub" lang="en">
			Wisdom from the Qur'an and Sunnah, in the language of Myanmar Muslims.
		</p>
	</section>

	<section class="container" aria-label="Hikmah ကို လေ့လာရန်">
		<div class="card-grid">
			<a class="card" href="/surahs/">
				<span class="card-icon material-symbols-outlined" aria-hidden="true"
					>book</span
				>
				<h2>
					<span lang="my">စူရဟ်များ</span>
					<span lang="en">· Surahs</span>
					<span class="page-count">{surahCount}</span>
				</h2>
				<p lang="my">
					မြန်မာဘာသာပြန်နှင့် အသံဖြင့် ဖတ်ရှုနားထောင်နိုင်သော အခြေခံစူရဟ်များ။
				</p>
				<span class="card-cta">
					<span lang="my">လေ့လာရန်</span>
					<span class="material-symbols-outlined" aria-hidden="true"
						>arrow_forward</span
					>
				</span>
			</a>

			<a class="card" href="/duas/">
				<span class="card-icon material-symbols-outlined" aria-hidden="true"
					>favorite</span
				>
				<h2>
					<span lang="my">ဒိုအာများ</span>
					<span lang="en">· Duas</span>
					<span class="page-count">{duaCount}</span>
				</h2>
				<p lang="my">နေ့စဉ်ဘဝအတွက် မရှိမဖြစ် ဒိုအာများကို အဓိပ္ပာယ်နှင့်တကွ။</p>
				<span class="card-cta">
					<span lang="my">လေ့လာရန်</span>
					<span class="material-symbols-outlined" aria-hidden="true"
						>arrow_forward</span
					>
				</span>
			</a>

			<a class="card" href="/names-of-allah/">
				<span class="card-icon material-symbols-outlined" aria-hidden="true"
					>star</span
				>
				<h2>
					<span lang="my">အလ္လာဟ်၏ နာမတော်များ</span>
					<span lang="en">· Names of Allah</span>
					<span class="page-count">{nameCount}</span>
				</h2>
				<p lang="my">
					အလ္လာဟ်အရှင်မြတ်၏ အလှပဆုံး နာမတော် (၁၀၀) ပါးကို အဓိပ္ပာယ်နှင့်တကွ။
				</p>
				<span class="card-cta">
					<span lang="my">လေ့လာရန်</span>
					<span class="material-symbols-outlined" aria-hidden="true"
						>arrow_forward</span
					>
				</span>
			</a>
		</div>
	</section>
</Layout>
