---
interface Props {
	label: string;
	placeholder?: string;
}

const { label, placeholder = label } = Astro.props;
---

<search class="list-filter">
	<span class="material-symbols-outlined" aria-hidden="true">search</span>
	<label class="visually-hidden" for="list-filter-input">{label}</label>
	<input
		id="list-filter-input"
		type="search"
		class="list-filter-input"
		data-list-filter
		placeholder={placeholder}
	/>
	<p class="visually-hidden" data-filter-live aria-live="polite"></p>
</search>

<script>
	// Fold text for forgiving search: lowercase, strip diacritics, unify Arabic variants.
	function foldText(text: string) {
		return text
			.toLowerCase()
			.normalize("NFD")
			.replace(/[\u0300-\u036f\u064b-\u065f\u0670]/g, "")
			.replace(/[\u0622\u0623\u0625\u0671]/g, "\u0627")
			.replace(/\u0649/g, "\u064a")
			.replace(/\u0629/g, "\u0647")
			.replace(/\u0640/g, "")
			.replace(/\s+/g, " ");
	}

	// Delegated listener: survives ClientRouter navigations without rebinding.
	document.addEventListener("input", (event) => {
		const input = event.target;
		if (
			!(input instanceof HTMLInputElement) ||
			!input.hasAttribute("data-list-filter")
		)
			return;
		const scope = input.closest("[data-filter-scope]");
		if (!scope) return;
		const list = scope.querySelector("[data-filter-list]");
		if (!list) return;

		const term = foldText(input.value);
		const items = [...list.querySelectorAll<HTMLElement>("[data-filter-item]")];
		let visible = 0;
		for (const item of items) {
			const match =
				!term ||
				(item.textContent ? foldText(item.textContent).includes(term) : false);
			item.hidden = !match;
			if (match) visible++;
		}

		const empty = scope.querySelector<HTMLElement>("[data-filter-empty]");
		if (empty) empty.hidden = visible !== 0;

		const live = scope.querySelector<HTMLElement>("[data-filter-live]");
		if (live)
			live.textContent = visible === 0 ? "ရလဒ် မတွေ့ပါ" : `ရလဒ် ${visible} ခု`;
	});
</script>
