---
interface Props {
	label: string;
	placeholder?: string;
	id?: string;
}

const { label, placeholder = label, id } = Astro.props;
// Deterministic id: allow explicit id, otherwise derive from label preserving
// Myanmar characters (U+1000–U+109F). Avoids random suffix / hydration mismatch.
const slug =
	id ??
	(label
		.toLowerCase()
		.replace(/[^a-z0-9\u1000-\u109f]+/g, "-")
		.replace(/^-+|-+$/g, "") ||
		"search");
const inputId = `list-filter-${slug}`;
---

<search class="list-filter">
	<span class="material-symbols-outlined" aria-hidden="true">search</span>
	<label class="visually-hidden" for={inputId}>{label}</label>
	<input
		id={inputId}
		type="search"
		class="list-filter-input"
		data-list-filter
		placeholder={placeholder}
		autocomplete="off"
		autocapitalize="off"
		spellcheck="false"
		inputmode="search"
	/>
	<p class="visually-hidden" data-filter-live aria-live="polite"></p>
</search>

<script>
	import { filterList } from "../utils/filterList";

	document.addEventListener("input", (event) => {
		const input = event.target;
		if (
			!(input instanceof HTMLInputElement) ||
			!input.hasAttribute("data-list-filter")
		)
			return;
		const scope = input.closest("[data-filter-scope]");
		const list = scope?.querySelector("[data-filter-list]");
		if (!scope || !list) return;

		filterList({
			term: input.value,
			items: [...list.querySelectorAll<HTMLElement>("[data-filter-item]")],
			empty: scope.querySelector<HTMLElement>("[data-filter-empty]"),
			live: scope.querySelector<HTMLElement>("[data-filter-live]"),
		});
	});
</script>
