---
import { getCollection } from "astro:content";

const year = new Date().getFullYear();

const surahs = await getCollection("surahs");
const duas = await getCollection("duas");

// Derive links from the actual content so a content reorder can never break them.
const pickSurah = (id: string) => {
	const surah = surahs.find((s) => s.id === id);
	return surah
		? {
				href: `/surahs/${surah.id}/`,
				label: surah.data.surah_metadata.name_transliteration,
			}
		: null;
};
const pickDua = (id: string) => {
	const dua = duas.find((d) => d.id === id);
	return dua ? { href: `/duas/${dua.id}/`, label: dua.data.title_en } : null;
};

const notableSurahs = [
	"surah-al-fatihah",
	"surah-al-ikhlas",
	"surah-al-falaq",
	"surah-an-nas",
]
	.map(pickSurah)
	.filter((x): x is { href: string; label: string } => x !== null);

const notableDuas = ["14", "2", "12", "9"]
	.map(pickDua)
	.filter((x): x is { href: string; label: string } => x !== null);
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-top">
			<div class="footer-col footer-about">
				<p class="footer-brand">Basirah</p>
				<p class="footer-note" lang="en">
					An ad-free Islamic knowledge site for Myanmar Muslims.
				</p>
			</div>

			<nav class="footer-col" aria-label="ထင်ရှားသော စူရဟ်များ">
				<h2>ထင်ရှားသော စူရဟ်များ</h2>
				<ul>
					{
						notableSurahs.map((surah) => (
							<li>
								<a href={surah.href} lang="en">
									{surah.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<nav class="footer-col" aria-label="ထင်ရှားသော ဒိုအာများ">
				<h2>ထင်ရှားသော ဒိုအာများ</h2>
				<ul>
					{
						notableDuas.map((dua) => (
							<li>
								<a href={dua.href} lang="en">
									{dua.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div class="footer-bottom">
			<p lang="en">© {year} Basirah</p>
			<p>
				အလ္လာဟ်အရှင်မြတ်၏
				ချစ်ခင်ခြင်း၊သနားကြင်နာခြင်းတို့ကိုတောင့်တမျှော်ကိုးလျက်
				ရည်ရွယ်၍မျှဝေပါသည်။
			</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		border-top: 1px solid var(--border);
		background: var(--surface-muted);
	}

	.site-footer::before {
		content: "";
		display: block;
		height: 2px;
		background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
		opacity: 0.7;
	}

	.footer-top {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: 2.5rem;
		padding-block: 3rem 2.25rem;
	}

	.footer-brand {
		font-family: var(--font-serif);
		font-size: 1.3rem;
		font-weight: 700;
	}

	.footer-note {
		margin-block-start: 0.9rem;
		max-width: 30ch;
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.footer-col h2 {
		margin-block: 0 1rem;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--text-muted);
	}

	.footer-col ul {
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.footer-col a {
		color: var(--text-muted);
		font-size: 0.95rem;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.footer-col a:hover {
		color: var(--primary);
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding-block: 1.25rem 2rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.footer-bottom p {
		margin: 0;
	}

	@media (max-width: 52rem) {
		.footer-top {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-block: 2.5rem 2rem;
		}
	}
</style>
