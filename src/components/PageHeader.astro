---
interface Props {
	title: string;
	arabic?: string;
	sub?: string;
	count?: number;
	stacked?: boolean;
}

const { title, arabic, sub, count, stacked = false } = Astro.props;
---

<header class="page-header">
	<h1>
		{title}
		{
			!stacked && arabic && (
				<span class="page-header-arabic isolated-rtl" lang="ar">
					{arabic}
				</span>
			)
		}
		{!stacked && count !== undefined && <span class="page-count">{count}</span>}
	</h1>
	{
		stacked && (arabic || count !== undefined) && (
			<p class="page-header-meta">
				{arabic && (
					<span class="page-header-arabic isolated-rtl" lang="ar">
						{arabic}
					</span>
				)}
				{count !== undefined && <span class="page-count">{count}</span>}
			</p>
		)
	}
	{sub && <p class="page-sub">{sub}</p>}
</header>
