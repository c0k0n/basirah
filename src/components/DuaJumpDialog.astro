---
import type { CollectionEntry } from "astro:content";

interface Props {
	duas: CollectionEntry<"duas">[];
	currentId: string;
}

const { duas, currentId } = Astro.props;
---

<dialog
	id="dua-jump-dialog"
	class="dua-jump-dialog"
	data-quick-dialog
	aria-labelledby="dua-quick-dialog-title"
>
	<div class="quick-dialog-head">
		<div class="quick-dialog-title-wrap">
			<span
				class="material-symbols-outlined quick-dialog-icon"
				aria-hidden="true">menu_book</span
			>
			<h2 id="dua-quick-dialog-title" class="quick-dialog-title">
				ဒိုအာရွေးချယ်ရန် <span lang="en">· Jump to dua</span>
			</h2>
		</div>
		<button
			type="button"
			class="quick-dialog-close"
			data-quick-close
			aria-label="ပိတ်ရန် · Close"
		>
			<span class="material-symbols-outlined" aria-hidden="true">close</span>
		</button>
	</div>

	<search class="quick-filter">
		<span class="material-symbols-outlined" aria-hidden="true">search</span>
		<label class="visually-hidden" for="dua-jump-filter">ဒိုအာရှာဖွေရန်</label>
		<input
			id="dua-jump-filter"
			type="search"
			class="quick-filter-input"
			data-quick-filter
			placeholder="အမည် သို့မဟုတ် အဓိပ္ပာယ်ဖြင့် ရှာဖွေရန်…"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			inputmode="search"
		/>
		<p class="visually-hidden" data-quick-live aria-live="polite"></p>
	</search>

	<div class="quick-list-wrap">
		<ul class="quick-list" data-quick-list>
			{
				duas.map((dua) => {
					const isCurrent = dua.id === currentId;
					return (
						<li data-filter-item>
							<a
								class:list={["quick-item", { "is-current": isCurrent }]}
								href={`/duas/${dua.id}/`}
								aria-current={isCurrent ? "page" : undefined}
							>
								<span class="quick-item-num" aria-hidden="true">
									{dua.id}
								</span>
								<span class="quick-item-main">
									<span class="dua-jump-titles">
										<span class="dua-jump-title-mm">{dua.data.title_mm}</span>
										<span class="dua-jump-title-en" lang="en">
											{dua.data.title_en}
										</span>
									</span>
								</span>
								<span
									class="quick-item-meta dua-jump-arabic"
									lang="ar"
									dir="rtl"
								>
									{dua.data.arabic}
								</span>
								{isCurrent && (
									<span class="quick-item-current" aria-hidden="true">
										<span class="material-symbols-outlined">star</span>
									</span>
								)}
							</a>
						</li>
					);
				})
			}
		</ul>
		<p class="quick-empty" data-quick-empty hidden>
			သင့်ရှာဖွေမှုနှင့် ကိုက်ညီသော ဒိုအာမတွေ့ပါ။
			<span lang="en">No duas found.</span>
		</p>
	</div>

	<p class="quick-dialog-foot">
		<span class="material-symbols-outlined" aria-hidden="true">search_off</span>
		<span>စုစုပေါင်း {duas.length} ဒိုအာ</span>
		<span lang="en">· {duas.length} duas</span>
	</p>
</dialog>

<script>
	import { filterList } from "../utils/filterList";

	const dialog = document.querySelector<HTMLDialogElement>(
		"[data-quick-dialog]",
	);
	const filterInput = document.querySelector<HTMLInputElement>(
		"[data-quick-filter]",
	);
	const list = document.querySelector<HTMLElement>("[data-quick-list]");
	const empty = document.querySelector<HTMLElement>("[data-quick-empty]");
	const live = document.querySelector<HTMLElement>("[data-quick-live]");

	let currentTrigger: HTMLElement | null = null;

	const openDialog = (event?: Event) => {
		if (!dialog || dialog.open) return;
		currentTrigger =
			event?.currentTarget instanceof HTMLElement ? event.currentTarget : null;
		dialog.showModal();
		requestAnimationFrame(() => filterInput?.focus());
	};

	const closeDialog = () => {
		dialog?.close();
	};

	document.querySelectorAll<HTMLElement>("[data-quick-open]").forEach((btn) => {
		btn.addEventListener("click", openDialog);
	});

	document
		.querySelectorAll<HTMLElement>("[data-quick-close]")
		.forEach((btn) => btn.addEventListener("click", closeDialog));

	dialog?.addEventListener("click", (event) => {
		if (event.target === dialog) closeDialog();
	});

	dialog?.addEventListener("close", () => {
		if (!filterInput || !list || !empty || !live) return;
		filterInput.value = "";
		const items = [...list.querySelectorAll<HTMLElement>("[data-filter-item]")];
		for (const item of items) item.hidden = false;
		empty.hidden = true;
		live.textContent = "";
		currentTrigger?.focus({ preventScroll: true });
		currentTrigger = null;
	});

	filterInput?.addEventListener("input", () => {
		if (!list || !empty) return;
		filterList({
			term: filterInput.value,
			items: [...list.querySelectorAll<HTMLElement>("[data-filter-item]")],
			empty,
			live,
		});
	});

	document.addEventListener("keydown", (event) => {
		if (
			event.key === "/" &&
			!dialog?.open &&
			!(event.target instanceof HTMLInputElement) &&
			!(event.target instanceof HTMLTextAreaElement)
		) {
			event.preventDefault();
			openDialog();
		}
	});
</script>

