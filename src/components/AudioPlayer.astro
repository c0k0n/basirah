---
interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<div
	class="audio-player"
	data-audio-player
	role="group"
	aria-label={`${title} ၏ အသံဖွင့်စက်`}
	data-title={title}
>
	<audio preload="none" src={src}>
		<p class="audio-fallback">
			သင့်ဘရောက်ဆာသည် အသံဖွင့်ခြင်းကို မပံ့ပိုးပါ။
			<a href={src}>{title} ၏ ရွတ်ဖတ်သံကို ဒေါင်းလုဒ်လုပ်ရန်</a>။
		</p>
	</audio>
	<button
		class="audio-play"
		type="button"
		data-audio-play
		aria-pressed="false"
		aria-label={`${title} ကို ဖွင့်ရန်/ရပ်ရန်`}
	>
		<span class="material-symbols-outlined" aria-hidden="true">play_arrow</span>
	</button>
	<div class="audio-times" aria-hidden="true">
		<span data-audio-current>0:00</span>
		/
		<span data-audio-duration>–:––</span>
	</div>
	<input
		class="audio-seek"
		type="range"
		min="0"
		max="1000"
		step="1"
		value="0"
		data-audio-seek
		aria-label={`${title} ၏ အချိန်ကို ရွှေ့ရန်`}
	/>
</div>
