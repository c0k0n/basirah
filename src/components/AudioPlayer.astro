---
interface Props {
	src: string;
	title: string;
	duration?: number | null;
}

const { src, title, duration } = Astro.props;

const hasDuration =
	typeof duration === "number" && Number.isFinite(duration) && duration > 0;
const formatTime = (seconds: number) =>
	`${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;
---

<section
	class="audio-player"
	data-audio-player
	aria-label={`${title} ၏ အသံဖွင့်စက်`}
	data-title={title}
	data-duration={duration}
>
	<span class="visually-hidden">ဖွင့်ပြီးချိန်</span>
	<time class="audio-time" data-audio-current datetime="PT0S">0:00</time>
	<audio preload="none" src={src}>
		<p class="audio-fallback">
			သင့်ဘရောက်ဆာသည် အသံဖွင့်ခြင်းကို မပံ့ပိုးပါ။
			<a href={src}>{title} ၏ ရွတ်ဖတ်သံကို ဒေါင်းလုဒ်လုပ်ရန်</a>။
		</p>
	</audio>
	<button
		class="audio-skip"
		type="button"
		data-audio-rewind
		aria-label={`${title} — ၁၀ စက္ကန့် နောက်ဆုတ်ရန်`}
		title="10s back"
	>
		<span class="material-symbols-outlined" aria-hidden="true">replay_10</span>
	</button>
	<button
		class="audio-play"
		type="button"
		data-audio-play
		aria-label={`${title} ကို ဖွင့်ရန်/ရပ်ရန်`}
	>
		<span class="material-symbols-outlined" aria-hidden="true">play_arrow</span>
	</button>
	<button
		class="audio-skip"
		type="button"
		data-audio-forward
		aria-label={`${title} — ၁၀ စက္ကန့် ရှေ့သို့`}
		title="10s forward"
	>
		<span class="material-symbols-outlined" aria-hidden="true">forward_10</span>
	</button>
	<span class="visually-hidden">ကျန်ရှိချိန်</span>
	{
		hasDuration ? (
			<time
				class="audio-time"
				data-audio-remaining
				datetime={`PT${Math.floor(duration!)}S`}
			>
				-{formatTime(duration!)}
			</time>
		) : (
			/* A <time> without a parseable datetime would be invalid HTML, so the
		   unknown-duration placeholder is a plain span. */
			<span class="audio-time" data-audio-remaining>
				–:––
			</span>
		)
	}
</section>

<script>
	const formatTime = (seconds: number) =>
		Number.isFinite(seconds)
			? `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`
			: "–:––";

	document
		.querySelectorAll<HTMLElement>("[data-audio-player]")
		.forEach((player) => {
			const audio = player.querySelector<HTMLAudioElement>("audio");
			const playButton =
				player.querySelector<HTMLButtonElement>("[data-audio-play]");
			const current = player.querySelector<HTMLElement>("[data-audio-current]");
			const remaining = player.querySelector<HTMLElement>(
				"[data-audio-remaining]",
			);
			const rewindButton = player.querySelector<HTMLButtonElement>(
				"[data-audio-rewind]",
			);
			const forwardButton = player.querySelector<HTMLButtonElement>(
				"[data-audio-forward]",
			);
			if (!audio || !playButton || !current || !remaining) return;

			const icon = playButton.querySelector<HTMLElement>(
				".material-symbols-outlined",
			);
			const title = player.dataset.title ?? "";
			// Duration baked at build time (utils/audioDuration.ts): hosts
			// without HTTP Range support never resolve audio.duration on their
			// own, so the real one is preferred only once it exists.
			const bakedDuration = Number(player.dataset.duration);
			const getDuration = () => {
				if (Number.isFinite(audio.duration) && audio.duration > 0)
					return audio.duration;
				return Number.isFinite(bakedDuration) && bakedDuration > 0
					? bakedDuration
					: NaN;
			};

			const setTimes = (seconds: number) => {
				current.textContent = formatTime(seconds);
				if (current instanceof HTMLTimeElement) {
					if (Number.isFinite(seconds))
						current.setAttribute("datetime", `PT${Math.floor(seconds)}S`);
					else current.removeAttribute("datetime");
				}

				const durationValue = getDuration();
				if (!Number.isFinite(durationValue)) {
					// No duration known at all — keep the placeholder.
					remaining.textContent = "–:––";
					if (remaining instanceof HTMLTimeElement)
						remaining.removeAttribute("datetime");
					return;
				}
				const left = Math.max(0, durationValue - seconds);
				remaining.textContent = left > 0 ? `-${formatTime(left)}` : "0:00";
				if (remaining instanceof HTMLTimeElement)
					remaining.setAttribute("datetime", `PT${Math.floor(left)}S`);
			};

			const updateState = () => {
				const playing = !audio.paused;
				// Dynamic accessible name only — no aria-pressed alongside a
				// changing label, per ARIA APG toggle-button guidance.
				playButton.setAttribute(
					"aria-label",
					playing ? `${title} ကို ရပ်ရန်` : `${title} ကို ဖွင့်ရန်`,
				);
				playButton.title = playing ? "Pause" : "Play";
				if (icon) icon.textContent = playing ? "pause" : "play_arrow";
			};

			const SKIP_SECONDS = 10;

			const skip = (delta: number) => {
				// Clamp to valid range; duration may be unknown before playback.
				const currentTime = Number.isFinite(audio.currentTime)
					? audio.currentTime
					: 0;
				let next = Math.max(0, currentTime + delta);
				const durationValue = getDuration();
				if (Number.isFinite(durationValue))
					next = Math.min(durationValue, next);
				audio.currentTime = next;
				setTimes(next);
			};

			playButton.addEventListener("click", () => {
				if (audio.paused) void audio.play().catch(() => {});
				else audio.pause();
			});
			rewindButton?.addEventListener("click", () => skip(-SKIP_SECONDS));
			forwardButton?.addEventListener("click", () => skip(SKIP_SECONDS));
			audio.addEventListener("play", updateState);
			audio.addEventListener("pause", updateState);
			audio.addEventListener("ended", updateState);
			audio.addEventListener("loadedmetadata", () =>
				setTimes(audio.currentTime),
			);
			audio.addEventListener("timeupdate", () => setTimes(audio.currentTime));
		});
</script>
