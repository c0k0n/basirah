---
import type { CollectionEntry } from "astro:content";

interface Props {
	surah: CollectionEntry<"surahs">;
}

const { surah } = Astro.props;
const meta = surah.data.surah_metadata;

const toArabicIndic = (n: number) =>
	String(n).replace(/\d/g, (d) => "٠١٢٣٤٥٦٧٨٩".charAt(Number(d)));
---

<li data-filter-item>
	<a class="surah-tile" href={`/surahs/${surah.id}/`}>
		<span class="surah-tile-num" aria-hidden="true">
			{toArabicIndic(meta.surah_number)}
		</span>
		<span class="surah-tile-arabic" lang="ar" dir="rtl">{meta.name_arabic}</span
		>
		<span class="surah-tile-name" lang="en">{meta.name_transliteration}</span>
		<span class="surah-tile-burmese">{meta.name_burmese_title}</span>
	</a>
</li>
