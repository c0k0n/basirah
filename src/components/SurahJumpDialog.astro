---
import type { CollectionEntry } from "astro:content";

interface Props {
	surahs: CollectionEntry<"surahs">[];
	currentId: string;
}

const { surahs, currentId } = Astro.props;
---

<dialog
	id="surah-jump-dialog"
	class="surah-jump-dialog"
	data-quick-dialog
	aria-labelledby="quick-dialog-title"
>
	<div class="quick-dialog-head">
		<div class="quick-dialog-title-wrap">
			<span
				class="material-symbols-outlined quick-dialog-icon"
				aria-hidden="true">menu_book</span
			>
			<h2 id="quick-dialog-title" class="quick-dialog-title">
				စူရဟ်ရွေးချယ်ရန် <span lang="en">· Jump to surah</span>
			</h2>
		</div>
		<button
			type="button"
			class="quick-dialog-close"
			data-quick-close
			aria-label="ပိတ်ရန် · Close"
		>
			<span class="material-symbols-outlined" aria-hidden="true">close</span>
		</button>
	</div>

	<search class="quick-filter">
		<span class="material-symbols-outlined" aria-hidden="true">search</span>
		<label class="visually-hidden" for="surah-jump-filter">စူရဟ်ရှာဖွေရန်</label
		>
		<input
			id="surah-jump-filter"
			type="search"
			class="quick-filter-input"
			data-quick-filter
			placeholder="အမည်၊ အသံထွက် သို့မဟုတ် အဓိပ္ပာယ်ဖြင့် ရှာဖွေရန်…"
			autocomplete="off"
		/>
		<p class="visually-hidden" data-quick-live aria-live="polite"></p>
	</search>

	<div class="quick-list-wrap" data-quick-list-wrap>
		<ul class="quick-list" data-quick-list>
			{
				surahs.map((surah) => {
					const m = surah.data.surah_metadata;
					const isCurrent = surah.id === currentId;
					return (
						<li data-filter-item>
							<a
								class:list={["quick-item", { "is-current": isCurrent }]}
								href={`/surahs/${surah.id}/`}
								aria-current={isCurrent ? "page" : undefined}
							>
								<span class="quick-item-num" aria-hidden="true">
									{m.surah_number}
								</span>
								<span class="quick-item-main">
									<span class="quick-item-arabic" lang="ar" dir="rtl">
										{m.name_arabic}
									</span>
									<span class="quick-item-text">
										<span class="quick-item-translit" lang="en">
											{m.name_transliteration}
										</span>
										<span class="quick-item-burmese">
											{m.name_burmese_title}
										</span>
									</span>
								</span>
								<span class="quick-item-meta">
									<span>{m.meaning_of_title.burmese}</span>
									<span lang="en">{m.meaning_of_title.english}</span>
								</span>
								{isCurrent && (
									<span class="quick-item-current" aria-hidden="true">
										<span class="material-symbols-outlined">star</span>
									</span>
								)}
							</a>
						</li>
					);
				})
			}
		</ul>
		<p class="quick-empty" data-quick-empty hidden>
			သင့်ရှာဖွေမှုနှင့် ကိုက်ညီသော စူရဟ်မတွေ့ပါ။
			<span lang="en">No surahs found.</span>
		</p>
	</div>

	<p class="quick-dialog-foot">
		<span class="material-symbols-outlined" aria-hidden="true">search_off</span>
		<span>စုစုပေါင်း {surahs.length} စူရဟ်</span>
		<span lang="en">· {surahs.length} surahs</span>
	</p>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>(
		"[data-quick-dialog]",
	);
	const filterInput = document.querySelector<HTMLInputElement>(
		"[data-quick-filter]",
	);
	const list = document.querySelector<HTMLElement>("[data-quick-list]");
	const empty = document.querySelector<HTMLElement>("[data-quick-empty]");
	const live = document.querySelector<HTMLElement>("[data-quick-live]");

	const foldText = (text: string) =>
		text
			.toLowerCase()
			.normalize("NFD")
			.replace(/[\u0300-\u036f\u064b-\u065f\u0670]/g, "")
			.replace(/[\u0622\u0623\u0625\u0671]/g, "ا")
			.replace(/\u0649/g, "ي")
			.replace(/\u0629/g, "ه")
			.replace(/\u0640/g, "")
			.replace(/\s+/g, " ");

	const openDialog = () => {
		if (!dialog || dialog.open) return;
		dialog.showModal();
		// Focus filter after open for immediate typing
		requestAnimationFrame(() => filterInput?.focus());
	};

	const closeDialog = () => {
		dialog?.close();
	};

	// Open triggers — any element with data-quick-open
	document.querySelectorAll<HTMLElement>("[data-quick-open]").forEach((btn) => {
		btn.addEventListener("click", openDialog);
	});

	// Close triggers
	document
		.querySelectorAll<HTMLElement>("[data-quick-close]")
		.forEach((btn) => btn.addEventListener("click", closeDialog));

	// Backdrop click: click on dialog itself (not children) closes
	dialog?.addEventListener("click", (event) => {
		if (event.target === dialog) closeDialog();
	});

	// Reset filter on close
	dialog?.addEventListener("close", () => {
		if (!filterInput || !list || !empty || !live) return;
		filterInput.value = "";
		const items = [...list.querySelectorAll<HTMLElement>("[data-filter-item]")];
		for (const item of items) item.hidden = false;
		empty.hidden = true;
		live.textContent = "";
		// Return focus to the trigger that opened it (last active)
		const trigger = document.querySelector<HTMLElement>(
			"[data-quick-open]:focus",
		);
		if (!trigger) {
			// Fallback: first trigger
			document
				.querySelector<HTMLElement>("[data-quick-open]")
				?.focus({ preventScroll: true });
		}
	});

	// Live filter inside dialog
	filterInput?.addEventListener("input", () => {
		if (!list || !empty) return;
		const term = foldText(filterInput.value);
		const items = [...list.querySelectorAll<HTMLElement>("[data-filter-item]")];
		let visible = 0;
		for (const item of items) {
			const match =
				!term ||
				(item.textContent ? foldText(item.textContent).includes(term) : false);
			item.hidden = !match;
			if (match) visible++;
		}
		empty.hidden = visible !== 0;
		if (live) {
			live.textContent = visible === 0 ? "ရလဒ် မတွေ့ပါ" : `ရလဒ် ${visible} ခု`;
		}
	});

	// Keyboard: quick jump with "/" when not in input
	document.addEventListener("keydown", (event) => {
		if (
			event.key === "/" &&
			!dialog?.open &&
			!(event.target instanceof HTMLInputElement) &&
			!(event.target instanceof HTMLTextAreaElement)
		) {
			event.preventDefault();
			openDialog();
		}
	});
</script>

<style>
	.surah-jump-dialog {
		position: fixed;
		inset: 0;
		width: min(calc(100% - 2rem), 36rem);
		max-width: calc(100% - 2rem);
		height: fit-content;
		max-height: min(82vh, 52rem);
		margin: auto;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 16px;
		background: var(--surface);
		color: var(--text);
		box-shadow:
			0 12px 40px rgb(0 0 0 / 0.18),
			0 4px 16px rgb(0 0 0 / 0.12);
		overflow: hidden;
	}

	.surah-jump-dialog:not([open]) {
		display: none;
	}

	.surah-jump-dialog[open] {
		display: flex;
		flex-direction: column;
	}

	.surah-jump-dialog::backdrop {
		background: rgb(16 22 19 / 0.45);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
	}

	.quick-dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
		flex-shrink: 0;
	}

	.quick-dialog-title-wrap {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}

	.quick-dialog-icon {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 8px;
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		color: var(--primary);
		font-size: 20px;
		flex-shrink: 0;
	}

	.quick-dialog-title {
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.3;
		margin: 0;
	}

	.quick-dialog-title span {
		font-weight: 400;
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.quick-dialog-close {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--surface);
		color: var(--text-muted);
		cursor: pointer;
		flex-shrink: 0;
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.quick-dialog-close:hover {
		background: var(--surface-muted);
		color: var(--text);
		border-color: color-mix(in srgb, var(--primary) 25%, var(--border));
	}

	.quick-dialog-close .material-symbols-outlined {
		font-size: 20px;
	}

	.quick-filter {
		position: relative;
		padding: 0.85rem 1.25rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface-muted);
		flex-shrink: 0;
	}

	.quick-filter > .material-symbols-outlined {
		position: absolute;
		inset-inline-start: 2.1rem;
		top: 50%;
		translate: 0 -50%;
		color: var(--text-muted);
		font-size: 20px;
		pointer-events: none;
	}

	.quick-filter-input {
		width: 100%;
		padding: 0.65rem 1rem 0.65rem 2.6rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
	}

	.quick-filter-input::placeholder {
		color: var(--text-muted);
	}

	.quick-filter-input:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 0;
		border-color: transparent;
	}

	.quick-list-wrap {
		overflow-y: auto;
		overscroll-behavior: contain;
		flex: 1;
		min-height: 0;
		padding: 0.5rem;
		background: var(--surface);
	}

	.quick-list {
		list-style: none;
		display: grid;
		gap: 0.25rem;
	}

	.quick-item {
		display: grid;
		grid-template-columns: 2rem 1fr auto auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0.85rem;
		border-radius: 12px;
		border: 1px solid transparent;
		text-decoration: none;
		color: inherit;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;
	}

	.quick-item:hover {
		background: var(--surface-muted);
		border-color: var(--border);
	}

	.quick-item.is-current {
		background: color-mix(in srgb, var(--primary) 10%, var(--surface));
		border-color: color-mix(in srgb, var(--primary) 22%, transparent);
	}

	.quick-item.is-current:hover {
		background: color-mix(in srgb, var(--primary) 14%, var(--surface));
	}

	.quick-item-num {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--surface-muted);
		border: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--text-muted);
		flex-shrink: 0;
	}

	.quick-item.is-current .quick-item-num {
		background: var(--primary);
		color: var(--primary-contrast);
		border-color: var(--primary);
	}

	.quick-item-main {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.quick-item-arabic {
		width: 5.5rem;
		font-family: var(--font-arabic);
		font-size: 1.25rem;
		line-height: 1.4;
		color: var(--text);
		text-align: center;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.quick-item-text {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		min-width: 0;
		text-align: left;
		justify-content: center;
	}

	.quick-item-translit {
		font-family: var(--font-serif);
		font-weight: 700;
		font-size: 0.92rem;
		line-height: 1.3;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.quick-item-burmese {
		font-size: 0.82rem;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.quick-item-meta {
		display: none;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
		gap: 0.05rem;
		min-width: 0;
		margin-inline-start: auto;
		padding-inline-start: 0.5rem;
	}

	.quick-item-meta span:first-child {
		font-size: 0.78rem;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 9rem;
	}

	.quick-item-meta span:last-child {
		font-size: 0.72rem;
		color: color-mix(in srgb, var(--text-muted) 80%, transparent);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 9rem;
	}

	.quick-item-current {
		display: grid;
		place-items: center;
		color: var(--primary);
		flex-shrink: 0;
	}

	.quick-item-current .material-symbols-outlined {
		font-size: 18px;
		font-variation-settings:
			"FILL" 1,
			"wght" 400,
			"GRAD" 0,
			"opsz" 24;
	}

	@media (min-width: 32rem) {
		.quick-item {
			grid-template-columns: 2rem 1fr auto auto;
		}

		.quick-item-meta {
			display: flex;
		}
	}

	@media (max-width: 31.99rem) {
		.quick-item {
			grid-template-columns: 2rem 1fr auto;
		}
	}

	.quick-empty {
		padding: 2rem 1.25rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.quick-dialog-foot {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		padding: 0.75rem 1.25rem;
		border-top: 1px solid var(--border);
		background: var(--surface-muted);
		color: var(--text-muted);
		font-size: 0.8rem;
		flex-shrink: 0;
	}

	.quick-dialog-foot .material-symbols-outlined {
		font-size: 16px;
	}

	@media (max-width: 30rem) {
		.surah-jump-dialog {
			width: calc(100% - 1rem);
			max-height: 85vh;
			border-radius: 14px;
		}

		.quick-item {
			padding: 0.6rem 0.75rem;
		}

		.quick-item-arabic {
			font-size: 1.1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.surah-jump-dialog::backdrop {
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
		}
	}
</style>
