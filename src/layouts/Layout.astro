---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/content.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	noindex?: boolean;
}

const {
	title = "Hikmah — Wisdom from the Qur'an & Sunnah",
	description = "Hikmah shares the wisdom of the Qur'an and Sunnah in Burmese: essential surahs, duas, and the beautiful names of Allah.",
	lang = "my",
	noindex = false,
} = Astro.props;

const canonicalPath = Astro.url.pathname === "/" ? "/" : `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL("/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfbf7" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101613" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="max-image-preview:large" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{!noindex && <link rel="canonical" href={canonicalUrl} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Hikmah" />
		<meta property="og:locale" content="my_MM" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Hikmah — Wisdom from the Qur'an and Sunnah, in the language of Myanmar Muslims" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<Font cssVariable="--font-myanmar-serif" />
		<Font cssVariable="--font-myanmar-sans" />
		<Font cssVariable="--font-arabic" />
		<Font cssVariable="--font-serif" preload={[{ subset: "latin", style: "normal" }]} />
		<Font cssVariable="--font-sans" preload={[{ subset: "latin", style: "normal" }]} />
		<Font cssVariable="--font-mono" />
		<Font cssVariable="--font-icons" />

		<ClientRouter />

		<script is:inline>
			if (!window.__hikmahThemeReady) {
				window.__hikmahThemeReady = true;
				const key = "hikmah-theme";
				function applyHikmahTheme() {
					const stored = localStorage.getItem(key);
					const theme = stored ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
					document.documentElement.classList.toggle("dark", theme === "dark");
					document.documentElement.setAttribute("data-theme", theme);
					document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
						btn.setAttribute("aria-pressed", String(theme === "dark"));
					});
				}
				applyHikmahTheme();
				document.addEventListener("astro:after-swap", applyHikmahTheme);
				document.addEventListener("astro:page-load", applyHikmahTheme);
				document.addEventListener("click", (event) => {
					const btn = event.target.closest("[data-theme-toggle]");
					if (!btn) return;
					localStorage.setItem(
						key,
						document.documentElement.classList.contains("dark") ? "light" : "dark",
					);
					applyHikmahTheme();
				});
			}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content <span lang="my">အကြောင်းအရာသို့ သွားရန်</span></a>
		<Header />
		<main id="main" class="container" tabindex="-1">
			<slot />
		</main>
		<Footer />

		<script>
			function closeNav() {
				document.body.classList.remove("nav-open");
				document.querySelectorAll("[data-menu-toggle]").forEach((b) => b.setAttribute("aria-expanded", "false"));
			}

			function toggleNav() {
				const open = document.querySelector("[data-menu-toggle]")?.getAttribute("aria-expanded") === "true";
				document.body.classList.toggle("nav-open", !open);
				document.querySelectorAll("[data-menu-toggle]").forEach((b) => b.setAttribute("aria-expanded", String(!open)));
			}

			document.addEventListener("astro:page-load", () => {
				const toggle = document.querySelector("[data-menu-toggle]");
				const nav = document.querySelector("[data-nav]");
				if (!toggle || !nav) return;
				toggle.addEventListener("click", toggleNav);
				nav.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeNav));
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") closeNav();
			});
		</script>
	</body>
</html>
