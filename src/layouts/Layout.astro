---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import { pwaInfo } from "virtual:pwa-info";
import { SITE } from "../site.config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/content.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	noindex?: boolean;
	ogType?: string;
}

const {
	title = SITE.title,
	description = SITE.description,
	lang = "my",
	noindex = false,
	ogType = "website",
} = Astro.props;

const canonicalPath =
	Astro.url.pathname === "/"
		? "/"
		: `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL("/og-image.png", Astro.site).href;
const robots = noindex
	? "noindex, nofollow"
	: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon-180x180.png"
		/>
		{
			pwaInfo?.webManifest && (
				<Fragment set:html={pwaInfo.webManifest.linkTag} />
			)
		}
		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="#fdfbf7"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="#101613"
		/>

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="google-site-verification"
			content="zAcKL0bX4UdVd2ViUyxubJXYgzOa_QF5UrnUI2uNydE"
		/>
		<meta name="msvalidate.01" content="101B3B6A64E722CFB477DCB121AECA79" />
		<meta name="robots" content={robots} />
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		{
			!noindex && (
				<>
					<link rel="alternate" hreflang={lang} href={canonicalUrl} />
					<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
					<link rel="sitemap" href="/sitemap-index.xml" />
				</>
			)
		}

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Basirah" />
		<meta property="og:locale" content="my_MM" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Basirah — ကုရ်အာန်နှင့် စွန္နသ်မှ ဗဟုသုတ"
		/>
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{
			/* Preload only the LCP-critical families; the rest stream in with
		    font-display:swap. Over-preloading blocks other critical resources. */
		}
		<Font
			cssVariable="--font-myanmar-sans"
			preload={[{ subset: "myanmar", style: "normal", weight: "400" }]}
		/>
		<Font
			cssVariable="--font-myanmar-serif"
			preload={[{ subset: "myanmar", style: "normal", weight: "700" }]}
		/>
		<Font
			cssVariable="--font-arabic"
			preload={[{ subset: "arabic", style: "normal", weight: "700" }]}
		/>

		{
			/* These families are used across the UI but are not LCP-critical,
		    so they are injected (so their CSS variable resolves) without
		    preloading. Without these, var(--font-icons/sans/serif/mono)
		    is undefined and icons render as literal ligature text. */
		}
		<Font cssVariable="--font-icons" />
		<Font cssVariable="--font-sans" />
		<Font cssVariable="--font-serif" />
		<Font cssVariable="--font-mono" />

		<ClientRouter />

		<script is:inline>
			/* THEME_BOOTSTRAP_START */
			if (!window.__basirahThemeReady) {
				window.__basirahThemeReady = true;
				const key = "basirah-theme";
				function applyBasirahTheme() {
					const stored = localStorage.getItem(key);
					const theme =
						stored ??
						(matchMedia("(prefers-color-scheme: dark)").matches
							? "dark"
							: "light");
					document.documentElement.classList.toggle("dark", theme === "dark");
					document.documentElement.setAttribute("data-theme", theme);
					document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
						btn.setAttribute("aria-pressed", String(theme === "dark"));
					});
				}
				applyBasirahTheme();
				document.addEventListener("astro:after-swap", applyBasirahTheme);
				document.addEventListener("astro:page-load", applyBasirahTheme);
				document.addEventListener("click", (event) => {
					const btn = event.target.closest("[data-theme-toggle]");
					if (!btn) return;
					localStorage.setItem(
						key,
						document.documentElement.classList.contains("dark")
							? "light"
							: "dark",
					);
					applyBasirahTheme();
				});
			}
			/* THEME_BOOTSTRAP_END */
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">အကြောင်းအရာသို့ သွားရန်</a>
		<Header />
		<main id="main" class="container" tabindex="-1">
			<slot />
		</main>
		<Footer />

		<script>
			import "../scripts/site";
		</script>
	</body>
</html>
