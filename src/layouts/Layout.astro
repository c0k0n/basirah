---
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../site.config";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import "../styles/content.css";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
	noindex?: boolean;
	ogType?: string;
}

const {
	title = SITE.title,
	description = SITE.description,
	lang = "my",
	noindex = false,
	ogType = "website",
} = Astro.props;

const canonicalPath =
	Astro.url.pathname === "/"
		? "/"
		: `${Astro.url.pathname.replace(/\/+$/, "")}/`;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const ogImageUrl = new URL("/og-image.png", Astro.site).href;
const hreflang = lang === "my" ? "my-MM" : lang;
const robots = noindex
	? "noindex, nofollow"
	: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon-180x180.png"
		/>
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="theme-color" content="#fdfbf7" data-theme-color />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="google-site-verification"
			content="zAcKL0bX4UdVd2ViUyxubJXYgzOa_QF5UrnUI2uNydE"
		/>
		<meta name="msvalidate.01" content="101B3B6A64E722CFB477DCB121AECA79" />
		<meta name="robots" content={robots} />
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		{
			!noindex && (
				<>
					<link rel="alternate" hreflang={hreflang} href={canonicalUrl} />
					<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
					<link rel="sitemap" href="/sitemap-index.xml" />
				</>
			)
		}

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Basirah" />
		<meta property="og:locale" content="my_MM" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonicalUrl} />}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="Basirah — ကုရ်အာန်နှင့် စွန္နသ်မှ ဗဟုသုတ"
		/>
		<meta property="og:locale:alternate" content="en_US" />
		<meta property="og:locale:alternate" content="ar_AR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<meta
			name="twitter:image:alt"
			content="Basirah — ကုရ်အာန်နှင့် စွန္နသ်မှ ဗဟုသုတ"
		/>

		{
			/* Preload only the LCP-critical families; the rest stream in with
		    font-display:swap. Over-preloading blocks other critical resources. */
		}
		<Font
			cssVariable="--font-myanmar-sans"
			preload={[{ subset: "myanmar", style: "normal", weight: "400" }]}
		/>
		<Font
			cssVariable="--font-myanmar-serif"
			preload={[{ subset: "myanmar", style: "normal", weight: "700" }]}
		/>
		<Font
			cssVariable="--font-arabic"
			preload={[{ subset: "arabic", style: "normal", weight: "700" }]}
		/>

		<Font cssVariable="--font-icons" />
		<Font cssVariable="--font-sans" />
		<Font cssVariable="--font-serif" />
		<Font cssVariable="--font-mono" />
	</head>
	<body>
		<a class="skip-link" href="#main">အကြောင်းအရာသို့ သွားရန်</a>
		<Header />
		<main id="main" class="container" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
