# Security headers
# The sha256 hash allows the small inline theme script in Layout.astro;
# it must be regenerated (openssl dgst -sha256 -binary | base64) if that script changes.
# static.cloudflareinsights.com is Cloudflare's Web Analytics beacon, injected at the edge.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-KxzH2T/h+p+PYsAlUS1H51BVNs7mjFO4IcSAmLlxoAs=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# The custom 404 page carries meta robots noindex; keep the header consistent
/404
  ! X-Robots-Tag

# Hashed build assets (scripts, styles, fonts, recitation audio) are immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be fetched fresh so updates propagate
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=86400
