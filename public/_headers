# Security headers — GENERATED by scripts/generate-headers.mts.
# Do not edit by hand; the CSP sha256 hash is derived from the inline theme
# script in Layout.astro so it can never drift out of sync.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-AbFzvHA8LzXiflABtp9BZJUIs1IOUc3Yaxq7DGxZniM=' https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# The custom 404 page carries meta robots noindex; keep the header consistent
/404
  ! X-Robots-Tag

# Hashed build assets (scripts, styles, fonts, recitation audio) are immutable
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker must always be fetched fresh so updates propagate
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Static HTML pages: short shared cache with stale-while-revalidate for repeat visits
/*.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
