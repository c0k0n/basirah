/*
  Security headers
*/
X-Content-Type-Options: nosniff
Referrer-Policy: strict-origin-when-cross-origin
X-Frame-Options: DENY
Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/*
  Hashed build assets are immutable
*/
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Recitations change rarely; short TTL keeps them cachable but refreshable
*/
/audio/*
  Cache-Control: public, max-age=86400
